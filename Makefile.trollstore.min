TARGET = iphone:clang:latest:14.0
ARCHS = arm64e
DEBUG = 0
FINALPACKAGE = 1
include $(THEOS)/makefiles/common.mk
TWEAK_NAME = DYYY
DYYY_FILES = DYYY.xm DYYYFloatSpeedButton.xm DYYYFloatClearButton.xm DYYYCityManager.m DYYYManager.m DYYYSettingViewController.m DYYYSwitchManager.m DYYYToast.m DYYYBottomAlertView.m DYYYUtils.m DYYYABTestHook.xm DYYYConfirmCloseView.m DYYYCustomInputView.m DYYYFilterSettingsView.m DYYYKeywordListView.m DYYYSelfTest.m DYYYCrashCatcher.m DYYYPaths.m DYYYSDKPatch.m
DYYY_CFLAGS = -fobjc-arc -w -O0 -Wno-everything -fobjc-runtime=ios-14.0
DYYY_LDFLAGS = -weak_framework AVFAudio
DYYY_FRAMEWORKS = UIKit Foundation Security CoreImage
CXXFLAGS += -std=c++11 -fno-rtti -fno-modules
DYYY_LOGOS_DEFAULT_GENERATOR = internal
export THEOS_STRICT_LOGOS=0 ERROR_ON_WARNINGS=0 LOGOS_DEFAULT_GENERATOR=internal
include $(THEOS_MAKE_PATH)/tweak.mk
.PHONY: trollstore
trollstore: all
	@mkdir -p build-trollstore-min
	@cp -f .theos/obj/arm64e/DYYY.dylib build-trollstore-min/DYYY.dylib
	@cp -f DYYY++.plist build-trollstore-min/DYYY.plist
	@echo Built build-trollstore-min/DYYY.dylib
