TARGET = iphone:clang:latest:14.0
ARCHS = arm64e
DEBUG = 0
FINALPACKAGE = 1
include $(THEOS)/makefiles/common.mk
TWEAK_NAME = DYYYProbe
DYYYProbe_FILES = DYYYProbe.xm
DYYYProbe_CFLAGS = -fobjc-arc -O0
include $(THEOS_MAKE_PATH)/tweak.mk
.PHONY: probe
probe: all
	@mkdir -p probe-build
	@cp -f .theos/obj/arm64e/DYYYProbe.dylib probe-build/DYYYProbe.dylib
	@cp -f DYYYProbe.plist probe-build/DYYYProbe.plist
